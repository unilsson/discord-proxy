# Match aliases to Discord channel names. Replace IDs and tokens in your private .env.
DISCORD_WEBHOOKS='{"general":"https://discord.com/api/webhooks/ID1/TOKEN1","tradera-watch":"https://discord.com/api/webhooks/ID2/TOKEN2"}'
DISCORD_DEFAULT_CHANNEL=general

# Optional: legacy fallback for older deployments. New installations do not need it.
